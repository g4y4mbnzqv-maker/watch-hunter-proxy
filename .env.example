# eBay developer keyset (Production), from https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Optional passcode for the whole app. Leave empty to keep it open.
APP_PASSCODE=

# Price index: a Postgres connection string. Adding a Neon database in
# Vercel's Storage tab sets DATABASE_URL for you.
DATABASE_URL=
# Lets Vercel Cron start the daily price harvest. Any long random string.
CRON_SECRET=
